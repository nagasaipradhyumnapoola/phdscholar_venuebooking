{
  "name": "research-office-pretalk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "demo:accounts": "node --env-file-if-exists=.env scripts/demo-accounts.js",
    "mail": "node --env-file-if-exists=.env scripts/mail.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "node --check server/app.js && node --check public/app.js && node --check public/enhancements.js && node --check public/theme.js && node --check public/error-page.js && npm test"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.1.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "svgo": "^4.1.0"
  }
}
