# Local development defaults. No production credentials are provided.
PORT=4173
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4173
DATABASE_PATH=./data/pretalk.sqlite
NODE_ENV=development
# capture: durable demo outbox; smtp: real delivery with your own provider
MAIL_MODE=capture
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Set true only for implicit TLS on port 465. STARTTLS required otherwise.
SMTP_SECURE=false
